{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: FastAPI",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "args": [
                "backend:app",
                "--reload",
                "--port",
                "8091"
            ],
            "env": {
                "SETS_CONFIG_JSON": "${workspaceFolder}/data/datasets/config_minimal.json"
            },
            "jinja": true
        },
    ]
}